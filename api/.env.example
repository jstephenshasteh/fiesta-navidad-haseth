# Copie este archivo como .env y complete los valores.

# --- Servidor ---
PORT=4000
# Orígenes permitidos para CORS (separados por coma). En producción la API sirve la web en el mismo dominio.
CORS_ORIGIN=http://localhost:5173
# Clave para firmar las sesiones (use un valor largo y aleatorio)
JWT_SECRET=cambie-esto-por-una-clave-larga-y-aleatoria
# Zona horaria para horas de llegada
TZ=America/Panama

# --- Oracle APEX (APIs REST / ORDS) ---
# URL base de ORDS con el alias del esquema (sin /fiesta/v1 al final). Ejemplos:
#   https://apex.oracle.com/pls/apex/haseth
#   https://xxxx.adb.us-ashburn-1.oraclecloudapps.com/ords/haseth
APEX_BASE_URL=
# Cliente OAuth creado con db/05_seguridad_oauth.sql.
# Si no ejecutó ese script (APIs sin protección), déjelos vacíos.
APEX_CLIENT_ID=
APEX_CLIENT_SECRET=
# Certificados: por defecto se confía también en los del sistema (Windows), útil si APEX usa
# un certificado interno de la empresa. Opcional: ruta a un certificado raíz exportado (Base-64).
# APEX_CERTIFICADOS_SISTEMA=true
# APEX_CA_CERT=certificados/ca-haseth.crt

# --- Correo (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Grupo De Haseth <eventos@su-dominio.com>"

# --- WhatsApp (360dialog) ---
D360_API_KEY=
D360_BASE_URL=https://waba-v2.360dialog.io
# Plantillas aprobadas por Meta (encabezado tipo IMAGEN).
# MODO DE PRUEBA: deje WA_TEMPLATE_PASE vacío y la app envía las 2 imágenes como mensajes
# normales (solo llegan a quien le escribió al número de la empresa en las últimas 24 horas).
# 1) Arte: encabezado = imagen del arte, cuerpo con {{1}} = nombre
WA_TEMPLATE_INVITACION=invitacion_fiesta_2026
# 2) Pase: encabezado = imagen del pase QR, cuerpo con {{1}} = código
WA_TEMPLATE_PASE=pase_qr_fiesta_2026
WA_TEMPLATE_LANG=es
# Código de país para números de 8 dígitos (Panamá)
WA_CODIGO_PAIS=507
# Segundos de espera entre el arte y el pase (para que el arte llegue primero)
WA_PAUSA_SEGUNDOS=5

# --- Primer administrador (opcional) ---
# Si FN_ADMIN está vacía, al arrancar se crea este administrador principal.
# Después de entrar la primera vez, borre ADMIN_INICIAL_PIN.
ADMIN_INICIAL_NOMBRE=
ADMIN_INICIAL_PIN=
